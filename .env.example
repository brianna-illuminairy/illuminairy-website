# Meta Pixel + Conversions API (SAT quiz funnel)
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Optional — tutor LP nav "Text us" link (US 10-digit, e.g. 6785551234)
# NEXT_PUBLIC_PARENT_SMS_PHONE=

# Public SAT Strategy Call (embedded on quiz s5 + /contact)
# Must match PUBLIC_SAT_STRATEGY_CALL_CALENDLY_URL in lib/site.ts — npm run verify:calendly-parity
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/satprep-illuminairy/sat-planning-session

# Skill Diagnostic (2 hr 14 min) — inline Calendly on /enroll after payment
# Create event type in Calendly, then match PUBLIC_SKILL_DIAGNOSTIC_CALENDLY_URL in lib/site.ts
NEXT_PUBLIC_SKILL_DIAGNOSTIC_CALENDLY_URL=https://calendly.com/satprep-illuminairy/sat-diagnostic-proctored-full-length-adaptive-testing

# Mentor application Typeform — embed on /apply/mentor (public)
# Create: TYPEFORM_API_TOKEN=... node scripts/create-mentor-typeform.mjs
# NEXT_PUBLIC_MENTOR_TYPEFORM_URL=https://form.typeform.com/to/XXXXXXXX

# SAT enrollment Typeform — parent + student intake after consult (form oWevli6O)
# Webhook: Typeform Connect → https://illuminairy.com/api/webhooks/typeform
# TYPEFORM_ENROLLMENT_FORM_ID=oWevli6O
# TYPEFORM_WEBHOOK_SECRET=   # from Typeform webhook settings (server-only)
# NEXT_PUBLIC_TYPEFORM_ENROLLMENT_URL=https://form.typeform.com/to/oWevli6O

# Invite-only mentor/tutor interview — send by email after vetting; never on public pages
TUTOR_CALENDLY_URL=https://calendly.com/brianna-illuminairy/tutor-call

# Contact form + transactional email (Resend) — not Plan B welcome (Klaviyo flow)
# API key: https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_INBOX=support@illuminairy.com
# After verifying illuminairy.com in Resend:
RESEND_FROM_EMAIL=

# PostHog — Project Settings → Project API key (phc_...)
NEXT_PUBLIC_POSTHOG_KEY=
# Aliases accepted by getPostHogKey() (same phc_ value):
# NEXT_PUBLIC_POSTHOG_TOKEN=
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Region hint for proxy rewrites (US default)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# One-time: enable session replay via npm run posthog:enable-recordings (never NEXT_PUBLIC_)
# POSTHOG_PERSONAL_API_KEY=phx_...
# POSTHOG_API_HOST=https://us.posthog.com
# Error tracking source maps (Vercel Production build only — never NEXT_PUBLIC_)
# POSTHOG_API_KEY=phx_...              # personal key, error-tracking write (PostHog wizard name)
# POSTHOG_PERSONAL_API_KEY=phx_...     # alias accepted by next.config.mjs
# POSTHOG_PROJECT_ID=428901
# POSTHOG_API_HOST=https://us.posthog.com

# Klaviyo (public company ID from Klaviyo → Settings → API keys)
NEXT_PUBLIC_KLAVIYO_PUBLIC_API_KEY=
# Optional: target a specific list (from Klaviyo → Lists)
NEXT_PUBLIC_KLAVIYO_LIST_ID=
# Platform waitlist (homepage) — create a dedicated list in Klaviyo
NEXT_PUBLIC_KLAVIYO_LIST_ID_PLATFORM_WAITLIST=
# Server-only — Events + Profiles API (never NEXT_PUBLIC_)
KLAVIYO_PRIVATE_API_KEY=
# Optional: SAT intake list (separate from newsletter list)
KLAVIYO_LIST_ID_SAT_FAMILIES=

# Supabase CRM (project agujbietvwcudihfgkef)
# Required for quiz S5 lead save (/api/funnel/lead). Empty key → "Could not save your details."
SUPABASE_URL=https://agujbietvwcudihfgkef.supabase.co
# Dashboard → Project Settings → API → service_role (server-only; never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# New-format secret key (alternative to JWT service_role):
# SUPABASE_SECRET_KEY=
# Optional publishable key — not used for CRM writes in v1
SUPABASE_PUBLISHABLE_KEY=
# Direct Postgres (migrations / scripts only — not used by Next.js runtime)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.agujbietvwcudihfgkef.supabase.co:5432/postgres
# Or set password only; scripts/apply-crm-migration.mjs builds the URL:
# SUPABASE_DB_PASSWORD=

# Student portal /danielle — comma-separated emails allowed to sign in
DANIELLE_ACCESS_ALLOWLIST=
# Map each allowlisted email to student, parent, or owner (for visit analytics)
# Example: dansodanielle9@gmail.com=student,bonsuc@gmail.com=parent,brianna@illuminairy.com=owner
DANIELLE_PORTAL_ROLES=
# Staff code for owner QA when signing in with a student/parent email (?staff=1 on login)
DANIELLE_OWNER_QA_SECRET=

# Danielle portal alerts — Resend (email) + Twilio (SMS) + Supabase tables (run npm run crm:migrate)
# Auto-register recipients (email=phone pairs, comma-separated). Email-only: email with no =phone
# Example: dansodanielle9@gmail.com=+14045551234,bonsuc@gmail.com=+14045559876
DANIELLE_NOTIFY_TARGETS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Student portal /soha — comma-separated emails allowed to sign in
SOHA_ACCESS_ALLOWLIST=
# Staff code for owner QA when signing in with a parent email (?staff=1 on login)
SOHA_OWNER_QA_SECRET=

# Internal admin dashboard (/admin)
ADMIN_SECRET=
# Daily funnel leak digest (Vercel Cron → /api/cron/marketing-digest, 13:00 UTC)
# PostHog error poll (Vercel Cron → /api/cron/posthog-alerts, 17:00 UTC — Hobby plan: once/day; use external cron for 4h on Pro)
CRON_SECRET=
MARKETING_DIGEST_EMAIL=brianna@illuminairy.com
# PostHog HogQL poll for $exception alerts (server-only; same phx_ key as error tracking)
# POSTHOG_PERSONAL_API_KEY=phx_...
# POSTHOG_PROJECT_ID=428901
# POSTHOG_API_HOST=https://us.posthog.com

# MentoMind browser automation (Phase 5+ — no public API)
# MENTOMIND_EMAIL=
# MENTOMIND_PASSWORD=

# Calendly API (Standard plan+ — Personal Access Token). Used for s5 slot list + server-side booking (Scheduling API; no Calendly popup).
CALENDLY_API_TOKEN=
# Returned when you run: npm run crm:calendly-webhook
CALENDLY_WEBHOOK_SIGNING_KEY=

# CRM v4: call intelligence + lead intelligence layer
# Google OAuth (illuminairy-crm project; redirect URIs locked to /api/admin/integrations/google/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generate: openssl rand -base64 32 (32-byte AES-256 key, base64-encoded)
INTEGRATION_TOKEN_ENC_KEY=
# Shared secret for GitHub-Actions-driven /api/cron/* routes. Generate: openssl rand -base64 32
CRON_SHARED_SECRET=
# Public origin for OAuth redirect + cron callbacks (e.g. https://www.illuminairy.com)
ILLUMINAIRY_BASE_URL=
# Gemini Flash API key (Google AI Studio) — call-intelligence summarization + scoring
GEMINI_API_KEY=
# GA4 Measurement Protocol — server-side milestone events (qualified, won)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Stripe (enrollment payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# One-time setup script only (USD cents, e.g. 150000 = $1,500.00)
# STRIPE_TUITION_CENTS=

# Plan Builder B — free lesson Calendly + portal
# Must match PUBLIC_FREE_LESSON_CALENDLY_URL in lib/site.ts
NEXT_PUBLIC_FREE_LESSON_CALENDLY_URL=https://calendly.com/satprep-illuminairy/free-sat-lesson

# June SAT Score Review funnel — must match PUBLIC_SCORE_REVIEW_CALENDLY_URL in lib/site.ts
NEXT_PUBLIC_SCORE_REVIEW_CALENDLY_URL=https://calendly.com/satprep-illuminairy/june-sat-score-review
# Signed parent portal cookie after free lesson book (openssl rand -base64 32)
PORTAL_SESSION_SECRET=
# Twilio SMS (Danielle portal alerts only — not Plan Builder B phone verify)
TWILIO_VERIFY_SERVICE_SID=

# Plan Builder B — Firebase Phone Auth (SMS OTP on /plan-b)
# Firebase console → Project settings → General → Your apps (Web app config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=331382853798
# reCAPTCHA Enterprise — illuminairy-web site key (GCP reCAPTCHA console)
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=6LfY4y4tAAAAAJIIuRDs0cKXvxWoN4JgKuWmKPJ6
# Server-only: separate GCP API key restricted to reCAPTCHA Enterprise API (NOT the browser/Firebase key)
# POST .../assessments?key=RECAPTCHA_ENTERPRISE_API_KEY — optional; phone SMS works via Firebase reCAPTCHA v2 without this
RECAPTCHA_ENTERPRISE_API_KEY=
# Server token verify — optional for other Admin SDK features.
# Plan B phone OTP uses Identity Toolkit accounts:lookup + Web API key (no JSON required).
# If you need Admin SDK elsewhere, use the default firebase-adminsdk service account:
# GCP → IAM → Service Accounts → firebase-adminsdk-fbsvc@… → Keys → Add key → JSON
# Option A (Vercel-friendly): paste full JSON on one line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Option B: split fields (escape newlines in private key as \n)
# FIREBASE_PROJECT_ID=illuminairy-plan-b-e4fc5
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@illuminairy-plan-b-e4fc5.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=
# NextAuth / Auth.js — Google + Facebook on /plan-b (b-email) and /portal/login
# Required: NEXTAUTH_SECRET (or AUTH_SECRET). Production: set NEXTAUTH_URL=https://illuminairy.com
# Google OAuth redirect URIs (Google Cloud console):
#   https://illuminairy.com/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
# Meta app → Facebook Login → Valid OAuth Redirect URIs:
#   https://illuminairy.com/api/auth/callback/facebook
#   http://localhost:3000/api/auth/callback/facebook
# Aliases accepted: AUTH_GOOGLE_ID/SECRET, GOOGLE_OAUTH_CLIENT_*, AUTH_FACEBOOK_ID/SECRET, FACEBOOK_APP_*
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
