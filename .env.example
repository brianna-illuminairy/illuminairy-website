# Booking (optional)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/brianna-illuminairy/august-sat

# Contact form → support@illuminairy.com
RESEND_API_KEY=
CONTACT_INBOX=support@illuminairy.com
# After verifying illuminairy.com in Resend:
# RESEND_FROM_EMAIL=Illuminairy <notifications@illuminairy.com>

# Klaviyo (public company ID from Klaviyo → Settings → API keys)
NEXT_PUBLIC_KLAVIYO_PUBLIC_API_KEY=
# Optional: target a specific list (from Klaviyo → Lists)
NEXT_PUBLIC_KLAVIYO_LIST_ID=

