      "ref": "fld_current_location",
      "title": "Where are you located right now?",
      "type": "multiple_choice",
      "properties": {
        "description": "We require mentors to be **physically in the United States** for the current SAT Accelerator cycle.",
        "choices": [
          {
            "ref": "choice_us_resident",
            "label": "United States (I am currently residing in the U.S.)"
          },
          {
            "ref": "choice_outside_us",
            "label": "Outside the United States"
          }
        ]
      },
      "validations": {
        "required": true
      }
    },
    {
